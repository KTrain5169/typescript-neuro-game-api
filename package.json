  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "body-parser": "^2.4.0",
    "express": "^5.3.0",
    "json-schema-faker": "^0.6.4",
    "jsr": "^0.14.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.93.0",
